import { useMemo, useRef } from "react";
import { useFrame } from "@react-three/fiber";
import * as THREE from "three";
import { getPlayerHex } from "@/constants/playerColors";

type MineColor = "RED" | "GREEN" | "BLUE" | "NEUTRAL";
export type MineType = "square" | "horizontal" | "vertical" | "cross" | "diagonal" | "cluster";

type MineProps = {
  position?: [number, number, number];
  color?: MineColor;
  type?: MineType;
};

type MineExplosionProps = {
  position?: [number, number, number];
  type?: MineType;
};

const TYPE_ACCENTS: Record<MineType, string> = {
  square: "#38bdf8",
  horizontal: "#f97316",
  vertical: "#facc15",
  cross: "#f43f5e",
  diagonal: "#a855f7",
  cluster: "#ffffff",
};

function TypeGlyph({ type, material }: { type: MineType; material: THREE.Material }) {
  if (type === "horizontal") {
    return (
      <>
        <mesh position={[0, 0.16, 0]} material={material}>
          <boxGeometry args={[1.35, 0.08, 0.18]} />
        </mesh>
        <mesh position={[-0.82, 0.16, 0]} rotation={[0, 0, Math.PI / 4]} material={material}>
          <boxGeometry args={[0.25, 0.07, 0.16]} />
        </mesh>
        <mesh position={[0.82, 0.16, 0]} rotation={[0, 0, -Math.PI / 4]} material={material}>
          <boxGeometry args={[0.25, 0.07, 0.16]} />
        </mesh>
      </>
    );
  }

  if (type === "vertical") {
    return (
      <>
        <mesh position={[0, 0.16, 0]} material={material}>
          <boxGeometry args={[0.18, 0.08, 1.35]} />
        </mesh>
        <mesh position={[0, 0.16, -0.82]} rotation={[Math.PI / 4, 0, 0]} material={material}>
          <boxGeometry args={[0.16, 0.07, 0.25]} />
        </mesh>
        <mesh position={[0, 0.16, 0.82]} rotation={[-Math.PI / 4, 0, 0]} material={material}>
          <boxGeometry args={[0.16, 0.07, 0.25]} />
        </mesh>
      </>
    );
  }

  if (type === "cross") {
    return (
      <>
        <mesh position={[0, 0.16, 0]} material={material}>
          <boxGeometry args={[1.25, 0.08, 0.16]} />
        </mesh>
        <mesh position={[0, 0.18, 0]} material={material}>
          <boxGeometry args={[0.16, 0.08, 1.25]} />
        </mesh>
      </>
    );
  }

  if (type === "diagonal") {
    return (
      <>
        <mesh position={[0, 0.16, 0]} rotation={[0, Math.PI / 4, 0]} material={material}>
          <boxGeometry args={[1.25, 0.08, 0.16]} />
        </mesh>
        <mesh position={[0, 0.18, 0]} rotation={[0, -Math.PI / 4, 0]} material={material}>
          <boxGeometry args={[1.25, 0.08, 0.16]} />
        </mesh>
      </>
    );
  }

  if (type === "cluster") {
    return (
      <>
        {[0, Math.PI / 2, Math.PI, Math.PI * 1.5].map((angle) => (
          <mesh
            key={angle}
            position={[Math.cos(angle) * 0.45, 0.18, Math.sin(angle) * 0.45]}
            material={material}
          >
            <sphereGeometry args={[0.13, 12, 12]} />
          </mesh>
        ))}
      </>
    );
  }

  return (
    <>
      {[Math.PI / 4, Math.PI * 0.75, Math.PI * 1.25, Math.PI * 1.75].map((angle) => (
        <mesh
          key={angle}
          position={[Math.cos(angle) * 0.42, 0.16, Math.sin(angle) * 0.42]}
          rotation={[0, angle, 0]}
          material={material}
        >
          <boxGeometry args={[0.22, 0.07, 0.22]} />
        </mesh>
      ))}
    </>
  );
}

export function Mine({ position = [0, 0, 0], color = "NEUTRAL", type = "square" }: MineProps) {
  const groupRef = useRef<THREE.Group>(null);
  const colorAccent = color === "NEUTRAL" ? "#ef4444" : getPlayerHex(color);
  const typeAccent = TYPE_ACCENTS[type];
  const warningColor = color === "NEUTRAL" ? typeAccent : colorAccent;

  const bodyMaterial = useMemo(() => new THREE.MeshStandardMaterial({
    color: "#08111f",
    metalness: 0.62,
    roughness: 0.28,
    emissive: "#0f172a",
    emissiveIntensity: 0.25,
  }), []);

  const rimMaterial = useMemo(() => new THREE.MeshStandardMaterial({
    color: "#172554",
    metalness: 0.45,
    roughness: 0.35,
    emissive: warningColor,
    emissiveIntensity: color === "GREEN" ? 0.32 : 0.45,
  }), [warningColor, color]);

  const warningMaterial = useMemo(() => new THREE.MeshStandardMaterial({
    color: warningColor,
    emissive: warningColor,
    emissiveIntensity: color === "GREEN" ? 0.65 : 1.0,
  }), [warningColor, color]);

  useFrame((state) => {
    if (!groupRef.current) return;
    groupRef.current.rotation.y = state.clock.elapsedTime * 0.45;
    groupRef.current.position.y = position[1] + Math.sin(state.clock.elapsedTime * 2.0) * 0.08;
  });

  return (
    <group ref={groupRef} position={position}>
      {/* Dark, flat sci-fi base that matches the board's low-profile glowing style. */}
      <mesh material={bodyMaterial} castShadow>
        <cylinderGeometry args={[0.58, 0.72, 0.18, 6]} />
      </mesh>

      <mesh position={[0, 0.11, 0]} material={rimMaterial}>
        <cylinderGeometry args={[0.47, 0.52, 0.08, 6]} />
      </mesh>

      {/* The glyph shape communicates the mine's blast pattern. */}
      <TypeGlyph type={type} material={warningMaterial} />

      {/* Center charge. Cluster mines get a bigger core because they are the most dangerous. */}
      <mesh position={[0, 0.26, 0]} material={warningMaterial}>
        <sphereGeometry args={[type === "cluster" ? 0.19 : 0.14, 16, 16]} />
      </mesh>
    </group>
  );
}

export function MineExplosion({ position = [0, 0, 0], type = "square" }: MineExplosionProps) {
  const groupRef = useRef<THREE.Group>(null);
  const startTime = useRef<number | null>(null);
  const explosionColor = TYPE_ACCENTS[type];

  const burstMaterial = useMemo(() => new THREE.MeshBasicMaterial({
    color: explosionColor,
    transparent: true,
    opacity: 0.95,
    depthWrite: false,
  }), [explosionColor]);

  const coreMaterial = useMemo(() => new THREE.MeshBasicMaterial({
    color: "#ffffff",
    transparent: true,
    opacity: 0.9,
    depthWrite: false,
  }), []);

  useFrame((state) => {
    if (!groupRef.current) return;
    if (startTime.current === null) startTime.current = state.clock.elapsedTime;
    const age = state.clock.elapsedTime - startTime.current;
    const progress = Math.min(age / 0.45, 1);
    const scale = 0.45 + progress * (type === "cluster" ? 3.2 : 2.35);

    groupRef.current.scale.set(scale, scale, scale);
    groupRef.current.rotation.y = progress * Math.PI;
    burstMaterial.opacity = Math.max(0, 0.95 * (1 - progress));
    coreMaterial.opacity = Math.max(0, 0.9 * (1 - progress * 1.2));
  });

  return (
    <group ref={groupRef} position={position}>
      <mesh rotation={[Math.PI / 2, 0, 0]} material={burstMaterial}>
        <torusGeometry args={[0.42, 0.025, 8, 48]} />
      </mesh>
      <mesh material={coreMaterial}>
        <sphereGeometry args={[0.24, 16, 16]} />
      </mesh>
      {[0, Math.PI / 2, Math.PI, Math.PI * 1.5].map((angle) => (
        <mesh
          key={angle}
          position={[Math.cos(angle) * 0.45, 0, Math.sin(angle) * 0.45]}
          material={burstMaterial}
        >
          <sphereGeometry args={[0.08, 8, 8]} />
        </mesh>
      ))}
    </group>
  );
}
